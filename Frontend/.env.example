# Base URL of the brackett backend, without a trailing slash.
# Leave unset to use the same-origin "/api" path, which only works where the host
# proxies /api to the backend (Vercel does this via vercel.json; the Vite dev
# server does it via server.proxy). On GitHub Pages this must be set explicitly.
VITE_API_BASE_URL=http://localhost:4000
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
